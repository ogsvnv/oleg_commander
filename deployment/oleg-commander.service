[Unit]
Description=Oleg Commander MCP Server
After=network.target

[Service]
Type=simple
User=ogsvnv
ExecStart=/usr/bin/python3 -m src.oleg_commander.server
Restart=always
RestartSec=10
WorkingDirectory=/home/ogsvnv/Develop/oleg_commander
Environment=PYTHONPATH=/home/ogsvnv/Develop/oleg_commander/src

[Install]
WantedBy=default.target